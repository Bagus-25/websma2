:root {
    --bg-gradient: linear-gradient(to bottom, #3b1c8c 0%, #2575fc 50%, #6a11cb 100%);
    --accent-red: #d32f2f;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
    font-family: 'Outfit', sans-serif;
    color: white;
    height: 100vh;
    background: var(--bg-gradient);
    background-size: 400% 400%;
    animation: gradientBG 10s ease infinite;
    overflow: hidden;
}

@keyframes gradientBG {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.slide {
    display: none; height: 100%; width: 100%;
    justify-content: center; align-items: center; position: absolute;
}

.slide.active { display: flex; flex-direction: column; }

/* LOGIN DESIGN */
.login-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 3rem; border-radius: 20px; text-align: center;
    width: 90%; max-width: 400px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
}

.school-logo-login { width: 100px; margin-bottom: 1rem; background: white; border-radius: 50%; padding: 5px; }

.input-group { text-align: left; margin-bottom: 1rem; }
.input-group label { display: block; font-size: 0.8rem; margin-bottom: 5px; opacity: 0.8; }
.input-group input { width: 100%; padding: 12px; border-radius: 8px; border: none; background: rgba(255,255,255,0.2); color: white; }

.btn-login { width: 100%; padding: 12px; background: white; color: #3b1c8c; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 10px; }

/* RESULT DESIGN */
.top-nav { position: absolute; top: 0; width: 100%; display: flex; justify-content: space-between; padding: 20px 30px; font-size: 0.8rem; }
.logout-link { color: white; text-decoration: none; opacity: 0.7; }

.result-content { text-align: center; max-width: 500px; padding: 20px; }
.app-title { font-size: 0.7rem; opacity: 0.6; letter-spacing: 1px; margin-bottom: 2rem; }
.student-name { font-weight: 400; margin-bottom: 2rem; font-size: 1.1rem; }

.status-container { display: flex; align-items: center; justify-content: center; gap: 15px; margin-bottom: 1.5rem; }
.status-badge { background: var(--accent-red); width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 15px rgba(211,47,47,0.5); }
.status-text { font-size: 1.8rem; font-weight: 700; }

.info-message { font-size: 0.9rem; line-height: 1.5; opacity: 0.9; margin-bottom: 3rem; }
.try-again { color: #ff6b6b; font-weight: 700; margin-top: 10px; }

.visitor-card { background: white; color: #333; padding: 8px 15px; border-radius: 5px; display: inline-flex; flex-direction: column; margin-top: 10px; }
.v-label { font-size: 0.5rem; color: #999; font-weight: 700; }
.v-number { font-size: 1rem; font-weight: 700; color: #3b1c8c; }

/* PRELOADER */
#preloader { position: fixed; inset: 0; background: #3b1c8c; z-index: 100; display: flex; justify-content: center; align-items: center; transition: 0.5s; }
#preloader.fade { opacity: 0; visibility: hidden; }
